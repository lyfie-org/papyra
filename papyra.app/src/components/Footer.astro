---
import Icon from './Icon.astro';
import { CREATOR_URL, DOCKER_HUB_URL, GITHUB_URL, LICENSE, LYFIE_URL } from '../data/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#features', label: 'Features' },
      { href: '/demo/', label: 'Live demo' },
      { href: '/#journey', label: 'Journey' },
      { href: '/changelog/', label: 'Changelog' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { href: '/docs/install/', label: 'Install' },
      { href: '/docs/importing/', label: 'Import your notes' },
      { href: '/docs/', label: 'All docs' },
      { href: '/api/', label: 'API reference' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/contribute/', label: 'Contribute' },
      { href: GITHUB_URL, label: 'GitHub', external: true },
      { href: DOCKER_HUB_URL, label: 'Docker Hub', external: true },
      { href: '/docs/security/', label: 'Security' },
      { href: LYFIE_URL, label: 'Lyfie', external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__mark">Papyra</p>
      <p class="site-footer__blurb">
        A calm, beautiful home for your notes — on your own server, in plain Markdown.
      </p>
      <p class="site-footer__family">
        A <a href={LYFIE_URL} rel="noopener">Lyfie</a> project.
      </p>
      <p class="site-footer__icons">
        <a href={GITHUB_URL} rel="noopener noreferrer" aria-label="Papyra on GitHub">
          <Icon name="github" size={18} />
        </a>
        <a href={DOCKER_HUB_URL} rel="noopener noreferrer" aria-label="Papyra on Docker Hub">
          <Icon name="docker" size={18} />
        </a>
      </p>
    </div>

    {
      columns.map((col) => (
        <nav class="site-footer__col">
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href} rel={'external' in link ? 'noopener noreferrer' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="wrap site-footer__legal">
    <p>
      © {year} Papyra, a <a href={LYFIE_URL} rel="noopener">lyfie.org</a> project · Released under
      the {LICENSE}
    </p>
    <p>
      Partly vibe-coded by <a href={CREATOR_URL} rel="noopener">Rahul</a> — life’s too short to
      scroll through forums.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    padding-block: var(--space-10) var(--space-6);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1.4fr repeat(3, 1fr);
    align-items: start;
  }

  .site-footer__mark {
    font: 400 var(--fs-xl) / 1 var(--heading);
    color: var(--text-h);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-2);
  }

  .site-footer__blurb {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text);
    max-width: 32ch;
  }

  .site-footer__family {
    font-size: var(--fs-xs);
    color: var(--text);
    margin: 0 0 var(--space-4);
  }

  .site-footer__legal a,
  .site-footer__family a {
    color: inherit;
    text-decoration-color: var(--border-hover);
  }

  .site-footer__legal a:hover,
  .site-footer__family a:hover {
    color: var(--accent-text);
  }

  .site-footer__icons {
    display: flex;
    gap: var(--space-3);
    margin: 0;
  }

  .site-footer__icons a {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .site-footer__icons a:hover {
    border-color: var(--accent-border);
    color: var(--text-h);
  }

  .site-footer__col h2 {
    font: 500 var(--fs-xs) / 1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-h);
    margin: 0 0 var(--space-3);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__col a {
    font-size: var(--fs-sm);
    color: var(--text);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .site-footer__legal p {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text);
  }

  @media (max-width: 56rem) {
    .site-footer__inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }
  }
</style>
