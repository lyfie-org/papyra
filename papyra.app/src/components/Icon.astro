---
// Inlined icons — see src/lib/icons.ts for the glyphs and why they are inline.
import { ICONS, type IconName } from '../lib/icons';


interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const icon: { viewBox: string; body: string; filled?: boolean } = ICONS[name];
---

<svg
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill="none"
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icon.body}
/>
