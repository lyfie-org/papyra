---
// Inlined icons. The repo ships public/icons.svg, but its glyphs are filled with
// a hardcoded near-black (#08060d) and would vanish in dark mode, and external
// <use> sprite references are still patchy. Inlining with currentColor is
// theme-correct and costs no extra request. The GitHub mark is lifted verbatim
// from that sprite; the rest match the lucide set the app already uses.
interface Props {
  name: 'github' | 'docker' | 'arrow-right' | 'terminal' | 'book' | 'play';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const paths: Record<Props['name'], { viewBox: string; body: string; filled?: boolean }> = {
