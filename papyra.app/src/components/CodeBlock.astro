---
// A code sample with an optional label and a copy button.
//
// Astro ships Shiki for fenced code inside MDX; this component is for code passed
// as a prop from .astro pages, where highlighting would mean shipping a
// highlighter to the client for no real gain. Plain, monospaced, high-contrast.
interface Props {
  code: string;
  lang?: string;
  /** Small caption above the block, e.g. "Terminal" or a file path. */
  label?: string;
  /** Hide the copy button for samples that are illustrative rather than runnable. */
  copyable?: boolean;
}

const { code, lang = 'text', label, copyable = true } = Astro.props;
const trimmed = code.replace(/\s+$/, '');
---

<div class="code" data-lang={lang}>
  {
    (label || copyable) && (
      <div class="code__bar">
        <span class="code__label">{label ?? lang}</span>
        {copyable && (
          <button type="button" class="code__copy" data-copy aria-label="Copy to clipboard">
            Copy
          </button>
        )}
      </div>
    )
  }
  <pre><code set:text={trimmed} /></pre>
</div>

<style>
  .code {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--code-bg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .code__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  .code__label {
    font: 400 var(--fs-2xs) / 1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .code__copy {
    padding: var(--space-1) var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    font: 500 var(--fs-2xs) / 1 var(--sans);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  .code__copy:hover {
    color: var(--text-h);
    border-color: var(--accent-border);
    background: var(--accent-bg);
  }

  .code__copy[data-copied] {
    color: var(--accent-text);
    border-color: var(--accent-border);
  }

  .code pre {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    background: transparent;
  }

  .code code {
    padding: 0;
    background: none;
    font-size: var(--fs-xs);
    line-height: 1.65;
    color: var(--text-h);
    white-space: pre;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.closest('.code')?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied';
        btn.dataset.copied = '';
      } catch {
        // Clipboard access can be refused (insecure context, permissions). Say so
        // rather than silently doing nothing — the reader can still select the text.
        btn.textContent = 'Select and copy';
      }
      window.setTimeout(() => {
        btn.textContent = 'Copy';
        delete btn.dataset.copied;
      }, 1600);
    });
  });
</script>
