---
import Icon from './Icon.astro';
// Fuzzy search across every docs page, section by section. The index
// (/docs/search.json) and Fuse.js load the first time the box is used, so pages
// that never search pay nothing. "/" or Ctrl/⌘K focuses it from anywhere.
---

<div class="dsearch" data-dsearch>
  <label class="dsearch__field">
    <Icon name="search" size={16} class="dsearch__icon" />
    <span class="sr-only">Search the documentation</span>
    <input
      type="search"
      class="dsearch__input"
      placeholder="Search docs"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="dsearch-results"
      aria-autocomplete="list"
    />
    <kbd class="dsearch__kbd" aria-hidden="true">/</kbd>
  </label>
  <ul class="dsearch__results" id="dsearch-results" role="listbox" aria-label="Search results" hidden></ul>
  <p class="dsearch__status" role="status" aria-live="polite"></p>
</div>

<script>
  import type Fuse from 'fuse.js';

  interface Section {
    t: string;
    h: string;
    u: string;
    x: string;
  }

  const root = document.querySelector<HTMLElement>('[data-dsearch]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('.dsearch__input')!;
    const list = root.querySelector<HTMLUListElement>('.dsearch__results')!;
    const status = root.querySelector<HTMLElement>('.dsearch__status')!;
    let fuse: Fuse<Section> | null = null;
    let loading: Promise<void> | null = null;
    let active = -1;

    const load = () =>
      (loading ??= (async () => {
        const [{ default: FuseCtor }, data] = await Promise.all([
          import('fuse.js'),
          fetch('/docs/search.json').then((r) => r.json() as Promise<Section[]>),
        ]);
        fuse = new FuseCtor(data, {
          keys: [
            { name: 'h', weight: 3 },
            { name: 't', weight: 2 },
            { name: 'x', weight: 1 },
          ],
          includeMatches: true,
          ignoreLocation: true,
          threshold: 0.38,
          minMatchCharLength: 2,
        });
      })());

    const escape = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    /** A window of text around the first match, with matches marked. */
    function snippet(text: string, ranges: readonly [number, number][]): string {
      if (!ranges.length) return escape(text.slice(0, 110)) + (text.length > 110 ? '…' : '');
      const [first] = ranges;
      const start = Math.max(0, first[0] - 40);
      const end = Math.min(text.length, start + 140);
      let out = start > 0 ? '…' : '';
      let at = start;
      for (const [a, b] of ranges) {
        if (b < start || a > end) continue;
        out += escape(text.slice(at, Math.max(at, a))) + '<mark>' + escape(text.slice(Math.max(a, at), b + 1)) + '</mark>';
        at = b + 1;
      }
      return out + escape(text.slice(at, end)) + (end < text.length ? '…' : '');
    }

    function setActive(i: number) {
      const items = [...list.children] as HTMLElement[];
      active = items.length ? (i + items.length) % items.length : -1;
      items.forEach((el, n) => el.setAttribute('aria-selected', String(n === active)));
      if (active >= 0) {
        input.setAttribute('aria-activedescendant', items[active].id);
        items[active].scrollIntoView({ block: 'nearest' });
      } else input.removeAttribute('aria-activedescendant');
    }

    function close() {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      setActive(-1);
    }

    async function run() {
      const q = input.value.trim();
      if (q.length < 2) {
        list.replaceChildren();
        status.textContent = '';
        close();
        return;
      }
      await load();
      if (q !== input.value.trim() || !fuse) return; // a newer keystroke won
      const hits = fuse.search(q, { limit: 8 });
      list.innerHTML = hits
        .map(({ item, matches }, i) => {
          const x = matches?.find((m) => m.key === 'x');
          const where = item.h ? `${escape(item.t)} <span aria-hidden="true">›</span> ${escape(item.h)}` : escape(item.t);
          return `<li id="dsearch-opt-${i}" role="option" aria-selected="false"><a href="${item.u}" tabindex="-1"><span class="dsearch__where">${where}</span><span class="dsearch__snip">${snippet(item.x, x?.indices ?? [])}</span></a></li>`;
        })
        .join('');
      status.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'}` : 'No matches';
      if (!hits.length) list.innerHTML = '<li class="dsearch__empty" role="presentation">Nothing matches — try fewer words.</li>';
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      setActive(hits.length ? 0 : -1);
    }

    let timer = 0;
    input.addEventListener('focus', () => void load());
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(run, 90);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter' && active >= 0) {
        e.preventDefault();
        list.querySelectorAll('a')[active]?.click();
      } else if (e.key === 'Escape') {
        if (!list.hidden) close();
        else input.blur();
      }
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
    list.addEventListener('click', () => close());

    document.addEventListener('keydown', (e) => {
      const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable="true"]');
      if ((e.key === '/' && !typing) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });
  }
</script>

<style>
  .dsearch {
    position: relative;
  }

  .dsearch__field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-3);
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .dsearch__field:hover {
    border-color: var(--border-hover);
  }

  .dsearch__field:focus-within {
    border-color: var(--border-focus);
  }

  .dsearch :global(.dsearch__icon) {
    flex: none;
    color: var(--text);
  }

  .dsearch__input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font: 400 var(--fs-sm) / 1 var(--sans);
    color: var(--text-h);
  }

  .dsearch__input::placeholder {
    color: var(--text);
  }

  .dsearch__input::-webkit-search-cancel-button {
    display: none;
  }

  .dsearch__kbd {
    flex: none;
    padding: 1px 7px;
    border: 1px solid var(--border);
    border-radius: 5px;
    font: 400 var(--fs-2xs) / 1.4 var(--mono);
    color: var(--text);
  }

  .dsearch__results {
    position: absolute;
    z-index: 25;
    top: calc(100% + 6px);
    left: 0;
    width: min(28rem, calc(100vw - 2 * var(--space-6)));
    max-height: min(26rem, 70vh);
    overflow-y: auto;
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-frame);
  }

  .dsearch__results :global(li a) {
    display: grid;
    gap: 2px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
  }

  .dsearch__results :global(li[aria-selected='true'] a),
  .dsearch__results :global(li a:hover) {
    background: var(--accent-bg);
  }

  .dsearch__results :global(.dsearch__where) {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-h);
  }

  .dsearch__results :global(.dsearch__snip) {
    font-size: var(--fs-xs);
    line-height: 1.45;
    color: var(--text);
  }

  .dsearch__results :global(mark) {
    background: var(--selection-bg, var(--accent-bg));
    color: var(--text-h);
    border-radius: 3px;
    padding: 0 1px;
  }

  .dsearch__results :global(.dsearch__empty) {
    padding: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--text);
  }

  .dsearch__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    margin: 0;
  }

  @media (hover: none) {
    .dsearch__kbd {
      display: none;
    }
  }
</style>
