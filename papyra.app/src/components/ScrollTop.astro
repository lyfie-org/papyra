---
import Icon from './Icon.astro';
// "Back to top": appears once you have scrolled a screen or two, on every page.
---

<button type="button" class="to-top" data-to-top aria-label="Back to top" hidden>
  <Icon name="arrow-up" size={18} />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (button) {
    button.hidden = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;
    const update = () => {
      button.toggleAttribute('data-shown', window.scrollY > window.innerHeight * 1.2);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
    button.addEventListener('click', (e) => {
      window.scrollTo({ top: 0, behavior: reduce.matches ? 'auto' : 'smooth' });
      // Keyboard users (a click with no pointer, detail 0) land back at the
      // start of the page rather than on a button that is about to vanish.
      if (e.detail === 0) document.querySelector<HTMLElement>('.skip-link')?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .to-top {
    position: fixed;
    right: max(var(--space-4), env(safe-area-inset-right));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    color: var(--text-h);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .to-top[data-shown] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .to-top:hover {
    border-color: var(--border-hover);
    color: var(--accent-text);
  }

  @media print {
    .to-top {
      display: none;
    }
  }
</style>
