---
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollTop from '../components/ScrollTop.astro';

interface Props {
  title: string;
  description: string;
  /** Omit the site-name suffix — used by the home page, whose title is already whole. */
  bareTitle?: boolean;
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
  /** og:type — "article" for documentation pages. */
  ogType?: 'website' | 'article';
}

const { title, description, bareTitle = false, noindex = false, ogType = 'website' } = Astro.props;
const fullTitle = bareTitle ? title : `${title} — Papyra`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content="Lyfie" />
    <meta name="application-name" content="Papyra" />
    {/* Plain-text versions of the whole site for AI assistants and crawlers
        (llmstxt.org), plus the sitemap for everything else. */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Papyra, summarised for AI assistants" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Papyra docs as plain text" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#7aaa8a" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Papyra" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* Generated by scripts/og.mjs, in a real browser so Marcellus renders
        properly. Served from public/ so the URL never changes with a hash —
        social scrapers cache aggressively. */}
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Papyra — a calm, private, self-hosted home for your notes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lyfieapp" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />

    {/* Only the two faces above the fold are preloaded; the rest arrive with the
        stylesheet. Self-hosted, so there is no third-party origin to reach. */}
    <link
      rel="preload"
      href="/fonts/marcellus-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/sora-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Anti-flash theme script, ported from papyra.web/index.html and sharing its
        `papyra-theme` key — so a visitor's choice carries into the /demo app,
        which is the same origin. Must run before first paint. */}
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('papyra-theme');
        var theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.add('js');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ScrollTop />
    <script>
      // Reveal [data-reveal] blocks as they scroll in (see site.css).
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Anything that leaves papyra.app opens in a new tab; this site and the
      // demo (same origin) stay in this one. Markdown links already carry it
      // from the build (rehype-external-links); this covers the components.
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        if (a.origin === location.origin || !/^https?:$/.test(a.protocol)) return;
        a.target = '_blank';
        a.relList.add('noopener', 'noreferrer');
      });
    </script>
  </body>
</html>
