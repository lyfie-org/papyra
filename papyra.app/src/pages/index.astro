---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Clip from '../components/Clip.astro';
import Vine from '../components/Vine.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import CodeBlock from '../components/CodeBlock.astro';
import logo from '../assets/papyra_logo.png';
import { GITHUB_URL, DESCRIPTION, LUTHOR_URL, LYFIE_URL, SITE_URL } from '../data/site';
import { FAQ, homeGraph } from '../data/about';
import { JOURNEY, NEXT } from '../data/journey';
import { readChangelog } from '../lib/changelog.mjs';
import { dockerPulls, roundedCount, starCount } from '../lib/stats.mjs';
import type { IconName } from '../lib/icons';

const { version } = readChangelog();
const stars = await starCount();
// A count only helps once there is one worth showing.
const starLabel = stars !== null && stars >= 10 ? `Star on GitHub · ${stars.toLocaleString('en-GB')}` : 'Star on GitHub';

const pulls = await dockerPulls();
const pullsLabel = pulls !== null && pulls >= 1000 ? roundedCount(pulls) : null;

// Structured data: who publishes Papyra (Lyfie), what it is, and its FAQ — so
// search engines and AI assistants describe it from facts, not guesses.
const jsonLd = homeGraph({ version, pulls, screenshot: `${SITE_URL}/media/clips/drop-light.webp` });

const installSample = `curl -O https://raw.githubusercontent.com/lyfie-org/papyra/main/docker-compose.hub.yml
docker compose -f docker-compose.hub.yml up -d

# then open http://localhost:8080`;

const facts: { icon: IconName; text: string }[] = [
  { icon: 'file', text: 'Plain Markdown files' },
  { icon: 'shield', text: 'No telemetry, ever' },
  pullsLabel
    ? { icon: 'docker', text: `${pullsLabel} Docker pulls` }
    : { icon: 'box', text: 'One Docker container' },
  { icon: 'heart', text: 'Free and open source' },
];

const showcase = [
  {
    clip: 'drop',
    eyebrow: 'Bring your notes',
    title: 'Drop in any Markdown.',
    text: 'Drag a .md file onto your desk and it’s a note — headings, checklists and all.',
    link: { href: '/demo/', label: 'Try it in the demo' },
    alt: 'A Markdown file is dragged onto the Papyra desk, becomes a note card, and opens fully formatted',
  },
  {
    clip: 'write',
    eyebrow: 'Write',
    title: 'It saves itself.',
    text: 'No save button, ever. Type [[ to link another note. Every version is kept, so you can always go back.',
    alt: 'Typing a new note: a heading, a [[ link to another note picked from a list, a bulleted list, then “Saved”',
  },
  {
    clip: 'search',
    eyebrow: 'Find',
    title: 'Anything, in a keystroke.',
    text: 'Press Ctrl K. Every word of every note, to-do and collection — matches highlighted.',
    alt: 'Searching for “pricing”: results from notes, to-dos and collections appear with the word highlighted',
  },
  {
    clip: 'vault',
    eyebrow: 'Protect',
    title: 'Lock what’s private.',
    text: 'Locked notes are encrypted on disk and open only with your PIN — or your fingerprint.',
    alt: 'A locked note stays blurred until the vault PIN is typed, then its contents appear',
  },
];

const everything: { icon: IconName; title: string; text: string }[] = [
  { icon: 'users', title: 'Live collaboration', text: 'Edit shared notes together, cursors and all.' },
  { icon: 'history', title: 'Version history', text: 'Every change kept. Restore any of them.' },
  { icon: 'link', title: 'Links and backlinks', text: 'Link notes with [[ and see what links back.' },
  { icon: 'wifi-off', title: 'Works offline', text: 'Keep writing on a plane. It syncs when you land.' },
  { icon: 'image', title: 'Pictures, PDFs, video', text: 'Drop files in. Preview them right in the note.' },
  { icon: 'message', title: 'Share and comment', text: 'Share a note, @mention, reply in threads.' },
  { icon: 'key', title: 'Passkeys and 2FA', text: 'Fingerprint sign-in, authenticator codes, SSO.' },
  { icon: 'git', title: 'Encrypted backups', text: 'Push your notes to a private Git repo, sealed.' },
  { icon: 'layers', title: 'Smart collections', text: 'Tags and filters that sort themselves.' },
  { icon: 'list-check', title: 'To-dos', text: 'Checklists that live beside your notes.' },
  { icon: 'smartphone', title: 'On every device', text: 'Install it on your phone, tablet and laptop.' },
  { icon: 'lock', title: 'For the whole family', text: 'Separate, private accounts on one server.' },
];

const imports: { icon: IconName; title: string; text: string }[] = [
  { icon: 'note', title: 'Google Keep', text: 'Import your Takeout archive. Checklists, labels, colours and pins come with it.' },
  { icon: 'gem', title: 'Obsidian', text: 'Upload your vault. Links, frontmatter and attachments arrive intact.' },
  { icon: 'file', title: 'Any Markdown', text: 'Drag files onto the desk. That’s the whole import.' },
];

const notCollected = ['Telemetry', 'Analytics', 'Crash reports', 'Usage pings', 'An account with us'];

const security: { icon: IconName; title: string; text: string }[] = [
  { icon: 'lock', title: 'Locked notes, sealed on disk', text: 'Encrypted at rest. Opened with your PIN — or your fingerprint.' },
  { icon: 'key', title: 'Sign-in, done properly', text: 'Passkeys, authenticator codes, SSO, and devices you can sign out.' },
  { icon: 'mail', title: 'Alerts from your own mail server', text: 'Add your SMTP: new sign-ins, password changes, failed backups.' },
  { icon: 'globe', title: 'Zero third-party requests', text: 'No CDNs, no trackers. Even the fonts come from your server.' },
];

const backups: { icon: IconName; title: string; text: string; featured?: boolean }[] = [
  {
    icon: 'git',
    title: 'Git sync',
    text: 'Papyra commits and pushes your notes to a private repo on a schedule — encrypted if you like, so even GitHub can’t read them. Full history, never force-pushed.',
    featured: true,
  },
  { icon: 'download', title: 'One-click export', text: 'Your whole vault as a zip, whenever you want it.' },
  { icon: 'archive', title: 'Encrypted archives', text: 'A sealed backup only your password opens.' },
  { icon: 'folder', title: 'Or just copy the folder', text: 'rsync, snapshots, your NAS backup — it all just works.' },
];

const helps: { icon: IconName; title: string; text: string; href: string }[] = [
  { icon: 'bug', title: 'Report a bug', text: 'Tell us what broke.', href: `${GITHUB_URL}/issues/new` },
  { icon: 'bulb', title: 'Suggest an idea', text: 'Say what you’re trying to do.', href: `${GITHUB_URL}/issues/new` },
  { icon: 'code', title: 'Send a pull request', text: 'Start with the guide.', href: '/contribute/' },
];

const SHOWN = 6;
const dayFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const monthFmt = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const when = (m: (typeof JOURNEY)[number]) =>
  (m.current ? monthFmt : dayFmt).format(new Date(`${m.date}T00:00:00Z`));
---

<Base
  title="Papyra — private, self-hosted Markdown notes app"
  description={DESCRIPTION}
  bareTitle
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <!-- ------------------------------------------------------------ hero -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrap wrap--wide hero__grid">
    <div class="hero__copy">
      <p class="chip hero__chip">
        <span class="chip__dot"></span>
        Papyra 1.0 · Free and open source
      </p>
      <h1 class="hero__title">Your notes deserve a <span>beautiful</span> home.</h1>
      <p class="hero__lede">
        A calm, self-hosted notes app — as easy as sticky notes, as deep as a wiki. Every note
        stays a plain Markdown file on your own server.
      </p>
      <div class="hero__actions">
        <a class="btn btn--lg" href="/demo/">
          <Icon name="play" size={16} />
          Try the live demo
        </a>
        <a class="btn btn--ghost btn--lg" href="#install">Install in a minute</a>
      </div>
      <p class="hero__note">No sign-up. The demo runs entirely in your browser.</p>
    </div>
    <div class="hero__shot">
      <HeroShowcase />
    </div>
    </div>
  </section>

  <!-- ----------------------------------------------------------- facts -->
  <section class="facts" aria-label="At a glance">
    <ul class="wrap facts__list">
      {
        facts.map((f) => (
          <li>
            <Icon name={f.icon} size={18} />
            {f.text}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- -------------------------------------------------------- showcase -->
  <section class="section" id="features">
    <div class="wrap wrap--wide features" data-vine-root>
      <Vine />
      <header class="intro" data-reveal data-vine-start>
        <p class="eyebrow">Made for writing</p>
        <h2>Calm on the surface.<br />Powerful underneath.</h2>
      </header>

      <div class="rows">
        {
          showcase.map((row, i) => (
            <article class:list={['row', { 'row--flip': i % 2 === 1 }]} data-reveal>
              <div class="row__copy">
                <p class="eyebrow">{row.eyebrow}</p>
                <h3>{row.title}</h3>
                <p>{row.text}</p>
                {row.link && (
                  <a class="row__link" href={row.link.href}>
                    {row.link.label}
                    <Icon name="arrow-right" size={15} />
                  </a>
                )}
              </div>
              <Clip class="row__clip" name={row.clip} label={row.alt} vine="side" />
            </article>
          ))
        }
      </div>

      <div class="theme-band" data-reveal>
        <div class="theme-band__copy">
          <p class="eyebrow">Day and night</p>
          <h3>Easy on the eyes.</h3>
          <p>Warm paper by day. Warm graphite by night.</p>
        </div>
        <Clip
          class="theme-band__clip"
          name="theme"
          single
          vine="top"
          label="The desk switching from the light theme to the dark one and back"
        />
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------ everything -->
  <section class="section section--tint">
    <div class="wrap">
      <header class="intro" data-reveal>
        <p class="eyebrow">And the rest</p>
        <h2>Everything you’d expect.<br />Nothing you won’t use.</h2>
      </header>
      <ul class="tiles">
        {
          everything.map((t, i) => (
            <li class="tile" data-reveal style={`--reveal-delay:${(i % 4) * 60}ms`}>
              <Icon name={t.icon} size={20} class="tile__icon" />
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---------------------------------------------------------- import -->
  <section class="section" id="import">
    <div class="wrap">
      <header class="intro" data-reveal>
        <p class="eyebrow">Move in tonight</p>
        <h2>Bring everything with you.</h2>
      </header>
      <div class="imports">
        {
          imports.map((imp, i) => (
            <div class="imports__card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="imports__icon">
                <Icon name={imp.icon} size={22} />
              </span>
              <h3>{imp.title}</h3>
              <p>{imp.text}</p>
            </div>
          ))
        }
      </div>
      <p class="imports__foot" data-reveal>
        Re-import any time — Papyra never duplicates a note.
        <a href="/docs/importing/">How importing works</a>
      </p>
    </div>
  </section>

  <!-- --------------------------------------------------------- privacy -->
  <section class="section section--tint" id="privacy">
    <div class="wrap privacy">
      <div class="privacy__copy" data-reveal>
        <p class="eyebrow">Private by default</p>
        <h2>Nothing phones home.</h2>
        <p>
          Your notes never leave your server — unless you share one, back it up to Git, or email
          yourself a sign-in alert.
        </p>
        <ul class="nope" aria-label="What Papyra never collects">
          {
            notCollected.map((item) => (
              <li>
                <Icon name="x" size={13} />
                {item}
              </li>
            ))
          }
        </ul>
        <figure class="quote">
          <blockquote>
            I’m a home-labber. Keeping my own data alive is hard enough — I have zero interest in
            storing yours.
          </blockquote>
        </figure>
      </div>
      <ul class="shields">
        {
          security.map((s, i) => (
            <li class="shields__card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="shields__icon">
                <Icon name={s.icon} size={20} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- --------------------------------------------------------- backups -->
  <section class="section" id="backups">
    <div class="wrap">
      <header class="intro" data-reveal>
        <p class="eyebrow">Backups</p>
        <h2>Your notes are just files.</h2>
        <p class="intro__lede">A folder of Markdown on your server. Four easy ways to keep a copy somewhere else.</p>
      </header>
      <ul class="vaults">
        {
          backups.map((b, i) => (
            <li class:list={['vaults__card', { 'vaults__card--featured': b.featured }]} data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="vaults__icon">
                <Icon name={b.icon} size={b.featured ? 24 : 20} />
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
      <aside class="warning" data-reveal>
        <Icon name="shield" size={20} class="warning__icon" />
        <div>
          <p>
            <strong>Back it up anyway.</strong> Papyra is young software. Keep at least one copy off
            the machine — and copy the whole <code>/data</code> folder, hidden <code>.papyra</code>
            folders included. Locked notes are encrypted on disk; without those keys nobody can open
            them, including you.
          </p>
          <a href="/docs/backups/">Backup guide</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- --------------------------------------------------------- journey -->
  <section class="section section--tint" id="journey">
    <div class="wrap wrap--narrow">
      <header class="intro" data-reveal>
        <p class="eyebrow">The journey</p>
        <h2>First commit to 1.0 in four months.</h2>
      </header>

      <ol class="journey" data-journey>
        {
          NEXT.map((n) => (
            <li class:list={['journey__item', 'journey__item--soon', { 'journey__item--next': n.next }]}>
              <span class="journey__date">Coming soon</span>
              <span class="journey__node" aria-hidden="true">
                <Icon name={n.next ? 'sparkles' : 'history'} size={12} />
              </span>
              <div class="journey__card">
                <h3>
                  <Icon name={n.icon} size={17} />
                  {n.title}
                </h3>
                <p>{n.text}</p>
                {n.next && <span class="journey__tag journey__tag--next">Next up</span>}
              </div>
            </li>
          ))
        }
        {
          JOURNEY.map((m, i) => (
            <li class:list={['journey__item', { 'journey__item--current': m.current }]} data-hidden={i >= SHOWN ? '' : undefined}>
              <time class="journey__date" datetime={m.date}>
                {when(m)}
              </time>
              <span class="journey__node" aria-hidden="true">
                {m.current ? <Icon name="star" size={12} /> : <Icon name="check" size={12} />}
              </span>
              <div class="journey__card">
                <h3>
                  <Icon name={m.icon} size={17} />
                  {m.title}
                </h3>
                <p>{m.text}</p>
                {m.version && (
                  <a class="journey__tag" href={m.version === '1.0' ? `${GITHUB_URL}/releases` : `/changelog/#v${m.version}`}>
                    v{m.version}
                  </a>
                )}
                {m.commit && (
                  <a class="journey__tag" href={`${GITHUB_URL}/commit/${m.commit}`} rel="noopener noreferrer" aria-label="The first commit on GitHub">
                    {m.commit.slice(0, 7)}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <div class="journey__more">
        <button type="button" class="btn btn--ghost" data-journey-toggle aria-expanded="false">
          Show all {JOURNEY.length} milestones
        </button>
        <a href="/changelog/">Full changelog</a>
      </div>
      <p class="journey__ask">
        Plans, not promises. Want something else?{' '}
        <a href={`${GITHUB_URL}/issues/new`} rel="noopener noreferrer">Ask for it</a>.
      </p>

    </div>
  </section>

  <!-- --------------------------------------------------------- install -->
  <section class="section" id="install">
    <div class="wrap install">
      <div data-reveal>
        <p class="eyebrow">Get started</p>
        <h2>Up in a minute.</h2>
        <p>
          Save one file, run one command, open your browser. The first account you create is the
          admin.
        </p>
        <ul class="ticks">
          <li><Icon name="check" size={16} />Runs on amd64 and arm64 — a NAS, a Pi, a VPS</li>
          <li><Icon name="check" size={16} />One container, one volume</li>
          <li><Icon name="check" size={16} />No accounts with us, no licence keys, no phoning home</li>
        </ul>
        <p class="install__links">
          <a class="btn btn--ghost" href="/docs/install/">
            <Icon name="book" size={16} />
            Install guide
          </a>
        </p>
      </div>
      <div class="install__code" data-reveal style="--reveal-delay:120ms">
        <CodeBlock lang="bash" label="Terminal" code={installSample} />
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------ contribute -->
  <section class="section section--tint" id="contribute">
    <div class="wrap contribute">
      <div data-reveal>
        <p class="eyebrow">Open source</p>
        <h2>Help shape what comes next.</h2>
        <p>Papyra is free, GPL-licensed and built in the open. Every bug report, idea and pull request counts.</p>
        <p class="contribute__star">
          <strong>Like it? Star it.</strong> A star on GitHub is the easiest way to show support —
          and it helps other people find Papyra.
        </p>
        <p class="contribute__actions">
          <a class="btn" href={GITHUB_URL} rel="noopener noreferrer">
            <Icon name="star" size={16} />
            {starLabel}
          </a>
          <a class="btn btn--ghost" href="/contribute/">Contributing guide</a>
        </p>
      </div>
      <ul class="helps">
        {
          helps.map((h, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <a class="helps__item" href={h.href} rel={h.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                <span class="helps__icon">
                  <Icon name={h.icon} size={18} />
                </span>
                <span>
                  <strong>{h.title}</strong>
                  <span>{h.text}</span>
                </span>
                <Icon name="arrow-right" size={16} class="helps__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ------------------------------------------------------------- faq -->
  <section class="section" id="faq">
    <div class="wrap wrap--narrow">
      <header class="intro" data-reveal>
        <p class="eyebrow">Questions</p>
        <h2>Good to know.</h2>
      </header>
      <div class="faq" data-reveal>
        {
          FAQ.map((item, i) => (
            <details class="faq__item" open={i === 0}>
              <summary>
                <h3>{item.q}</h3>
                <Icon name="arrow-right" size={16} class="faq__chev" />
              </summary>
              <p>
                {item.a}
                {item.q === 'Who makes Papyra?' && (
                  <>
                    {' '}
                    <a href={LYFIE_URL} rel="noopener">lyfie.org</a> ·{' '}
                    <a href={LUTHOR_URL} rel="noopener">luthor</a>
                  </>
                )}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

</Base>

<script>
  const list = document.querySelector<HTMLElement>('[data-journey]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-journey-toggle]');
  if (list && toggle) {
    const label = toggle.textContent?.trim() ?? '';
    toggle.addEventListener('click', () => {
      const open = list.toggleAttribute('data-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Show fewer' : label;
    });
  }
</script>

<style>
  /* ------------------------------------------------------------ hero */
  .hero {
    position: relative;
    padding-block: clamp(var(--space-10), 7vw, 6rem) clamp(var(--space-8), 4vw, var(--space-10));
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 46rem;
    pointer-events: none;
    background:
      radial-gradient(32rem 22rem at 30% 40%, var(--accent-bg), transparent 70%),
      radial-gradient(28rem 20rem at 72% 30%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%);
    filter: blur(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__glow {
      animation: glow-drift 18s var(--ease-inout) infinite alternate;
    }
  }

  @keyframes glow-drift {
    to {
      transform: translate3d(4%, 3%, 0) scale(1.06);
    }
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(var(--space-8), 4vw, var(--space-12));
    align-items: center;
  }

  .hero__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__chip {
    margin-bottom: var(--space-6);
  }

  .hero__title {
    font-size: clamp(40px, 3.4vw + 16px, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 11ch;
    margin-bottom: var(--space-5);
  }

  /* The one coloured word breathes: a slow drift through the palette's greens. */
  .hero__title span {
    color: var(--accent-text);
    background: linear-gradient(100deg, var(--accent-text) 0%, var(--accent) 35%, var(--accent-text) 60%, var(--accent) 100%) 0 0 / 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title span {
      animation: hero-ink 7s var(--ease-inout) infinite alternate;
    }
  }

  @keyframes hero-ink {
    to {
      background-position: 100% 0;
    }
  }

  .hero__lede {
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: var(--text);
    max-width: 34ch;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .hero__copy .hero__actions {
    justify-content: flex-start;
  }

  .hero__note {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-xs);
    color: var(--text);
  }

  .hero__shot {
    position: relative;
    min-width: 0;
    padding-left: var(--space-6);
  }

  @media (max-width: 69.99rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__copy {
      align-items: center;
      text-align: center;
    }

    .hero__title {
      max-width: 13ch;
    }

    .hero__lede {
      max-width: 44ch;
    }

    .hero__copy .hero__actions {
      justify-content: center;
    }

    .hero__shot {
      padding-left: 0;
      margin-top: var(--space-10);
    }
  }

