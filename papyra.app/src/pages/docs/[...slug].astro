---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { GITHUB_URL } from '../../data/site';

export async function getStaticPaths() {
  const order = ['Getting started', 'Living with it', 'In depth', 'Reference'];
  // Flattened in reading order, so prev/next walk the sidebar rather than
  // jumping between groups arbitrarily.
  const pages = (await getCollection('docs')).sort((a, b) => {
    const g = order.indexOf(a.data.group) - order.indexOf(b.data.group);
    return g !== 0 ? g : a.data.order - b.data.order;
  });

  return pages.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: pages[i - 1], next: pages[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const editUrl = `${GITHUB_URL}/edit/main/papyra.app/src/content/docs/${entry.id}.mdx`;
---

<Docs title={entry.data.title} description={entry.data.summary} current={entry.id}>
  <article>
    <p class="eyebrow">{entry.data.group}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede doc__summary">{entry.data.summary}</p>

    <div class="prose">
      <Content />
    </div>

    <nav class="doc__nav" aria-label="More documentation">
      {
        prev ? (
          <a class="doc__nav-link" href={`/docs/${prev.id}/`}>
            <span>Previous</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="doc__nav-link doc__nav-link--next" href={`/docs/${next.id}/`}>
            <span>Next</span>
            {next.data.title}
          </a>
        )
      }
    </nav>

    <p class="doc__edit">
      Something wrong or missing?{' '}
      <a href={editUrl} rel="noopener noreferrer">Improve this page on GitHub</a>.
    </p>
  </article>
</Docs>

<style>
  .doc__summary {
    max-width: 62ch;
    margin-bottom: var(--space-8);
  }






  .doc__nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .doc__nav-link {
    display: grid;
    gap: 2px;
    max-width: 20rem;
    font: 400 var(--fs-sm) / 1.3 var(--heading);
    color: var(--text-h);
    text-decoration: none;
  }

  .doc__nav-link--next {
    text-align: right;
  }

  .doc__nav-link span {
    font: 500 var(--fs-2xs) / 1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
  }

  .doc__nav-link:hover {
    color: var(--accent-text);
  }

  .doc__edit {
    margin-top: var(--space-6);
    font-size: var(--fs-xs);
    color: var(--text);
  }
</style>
