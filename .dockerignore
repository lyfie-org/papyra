papyra.api/**/bin/
papyra.api/**/obj/
papyra.api/**/TestResults/
papyra.api/**/*.trx

papyra.web/node_modules/
papyra.web/dist/

# Stale local SPA build — the frontend stage rebuilds and COPYs a fresh wwwroot
# into the publish stage, so never send a developer's local build into the context.
papyra.api/src/Papyra.Api/wwwroot/

node_modules/

# Runtime data only — NOT the Data/ source namespace. A blanket `data/` here
# excludes papyra.api/src/Papyra.Api/Data/ (case-insensitively / ambiguously) and
# breaks the publish build by dropping AppDbContext + EF migrations from the context.
/data/
.localdata/
**/.localdata/
papyra.api/src/Papyra.Api/Data/.papyra/
papyra.api/src/Papyra.Api/Data/notes/
papyra.api/src/Papyra.Api/Data/users/
papyra.api/src/Papyra.Api/Data/media/

.git/
.gitignore
.github/
.vs/
.vscode/
.idea/
**/.claude/
**/*.user
**/*.suo

papyra.api/**/appsettings.Development.json
papyra.web/.env.development
papyra.web/.env.local
