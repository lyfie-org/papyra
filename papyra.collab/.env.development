# `pnpm dev` only — must match papyra.api appsettings.Development.json (Collab:Url, Collab:Secret).
# Production never reads this: the API spawns the bundled engine with a per-boot secret.
PAPYRA_COLLAB_SECRET=dev-only-collab-secret-not-for-production-000000000000
PAPYRA_API_URL=http://localhost:5220
PAPYRA_COLLAB_PORT=5231
